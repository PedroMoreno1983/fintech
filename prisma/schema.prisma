  accion      CfoAuditAccion
  entidadTipo String
  entidadId   String
  antes       Json?
  despues     Json?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([empresaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([entidadTipo, entidadId])
}

enum CfoAuditAccion {
  CREAR
  ACTUALIZAR
  ELIMINAR
  APROBAR
  RECHAZAR
  CERRAR
  REABRIR
  IMPORTAR
  EXPORTAR
}

model CfoIndicadorEsg {
  id          String          @id @default(cuid())
  empresaId   String
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo      String
  nombre      String
  categoria   CfoCategoriaEsg
  unidad      String
  descripcion String?
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  mediciones CfoMedicionEsg[]

  @@unique([empresaId, codigo])
  @@index([empresaId, categoria, activo])
}

enum CfoCategoriaEsg {
  AMBIENTAL
  SOCIAL
  GOBERNANZA
}

model CfoMedicionEsg {
  id              String          @id @default(cuid())
  empresaId       String
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  indicadorId     String
  indicador       CfoIndicadorEsg @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  periodoId       String
  periodo         CfoPeriodo      @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  sociedadId      String?
  sociedad        CfoSociedad?    @relation(fields: [sociedadId], references: [id], onDelete: SetNull)
  centroCostoId   String?
  centroCosto     CfoCentroCosto? @relation(fields: [centroCostoId], references: [id], onDelete: SetNull)
  registradoPorId String?
  registradoPor   Usuario?        @relation("CfoMedicionEsgRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  valor           Decimal         @db.Decimal(18, 4)
  fuente          String?
  evidenciaUrl    String?
  comentario      String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([empresaId, periodoId])
  @@index([indicadorId, periodoId])
  @@index([sociedadId])
  @@index([centroCostoId])
  @@index([registradoPorId])
}
